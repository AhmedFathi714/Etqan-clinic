{
  "type": "module",
  "scripts": {
    "dev:css": "tailwindcss -c ./tailwind.config.js -i ./frontend/src/css/input.css -o ./frontend/src/output.css --watch",
    "dev:server": "vite --host",
    "dev": "concurrently -k \"npm run dev:css\" \"npm run dev:server\"",
    "build:css": "tailwindcss -c ./tailwind.config.js -i ./frontend/src/css/input.css -o ./frontend/src/output.css --minify",
    "build": "npm run build:css && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "live-server": "^1.2.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "flowbite": "^4.0.2"
  }
}
